{
  "name": "pledge",
  "version": "0.1.0",
  "private": true,
  "description": "A language for teaching restricted dependent types; runs in the browser.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "node --test 'src/**/*.test.ts'",
    "serve": "node serve.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
