data Nat() : Type() {
  Zero() : Nat();
  Succ(pred : Nat()) : Nat();
}

data Eq(A : Type(), a : A, b : A) : Type() {
  Refl(erased A : Type(), erased a : A) : Eq(A, a, a);
}

fn sym(erased A : Type(), erased a : A, erased b : A, p : Eq(A, a, b)) -> (q : Eq(A, b, a)) {
  let erased Refl(_, _) = p;
  Refl(_, _)
}

fn cong(erased a : Nat(), erased b : Nat(), p : Eq(Nat(), a, b)) -> (q : Eq(Nat(), Succ(a), Succ(b))) {
  match erased p : (q : Eq(Nat(), Succ(a), Succ(b))) {
    Refl(_, _) => Refl(_, _);
  }
}

goal Eq(Nat(), Succ(Succ(Zero())), Succ(Succ(Zero())));
qed sym(_, _, _, cong(_, _, Refl(_, Succ(Zero()))));
