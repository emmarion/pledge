data Nat() : Type() {
  Zero() : Nat();
  Succ(pred : Nat()) : Nat();
}

data Vec(A : Type(), n : Nat()) : Type() {
  VNil(erased A : Type()) : Vec(A, Zero());
  VCons(erased A : Type(), erased n : Nat(), head : A, rest : Vec(A, n)) : Vec(A, Succ(n));
}

data IsSucc(n : Nat()) : Type() {
  IsSuccHere(erased m : Nat()) : IsSucc(Succ(m));
}

data Eq(A : Type(), a : A, b : A) : Type() {
  Refl(erased A : Type(), erased a : A) : Eq(A, a, a);
}

fn cast(erased n : Nat(), erased m : Nat(), erased p : Eq(Nat(), n, m), v : Vec(Nat(), n)) -> (w : Vec(Nat(), m)) {
  match erased p : (w : Vec(Nat(), m)) {
    Refl(_, _) => v;
  }
}

fn first(erased n : Nat(), erased p : IsSucc(n), v : Vec(Nat(), n)) -> (x : Nat()) {
  match erased n : (x : Nat()) {
    Zero() => match erased p : (x : Nat()) {};
    Succ(k) => {
      let VCons(_, _, h, _) = v;
      h
    };
  }
}

let v = VCons(_, _, Succ(Succ(Zero())), VCons(_, _, Zero(), VNil(_)));
print first(_, IsSuccHere(Succ(Zero())), cast(_, Succ(Succ(Zero())), Refl(_, _), v));
print cast(_, Succ(Succ(Zero())), Refl(_, _), v);
