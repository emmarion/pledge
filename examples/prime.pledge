-- Primality by reflection.
-- Prime(n) is meant to say that n >= 2 and that no d with 2 <= d < n divides n, where "d does not divide n"
-- is a division with a nonzero remainder (DivMod, NotDivides, NoDivBelow). As a check on that definition, the
-- goal (primeFactor) is that if Prime(n) and a * b = n, then a or b is one.
-- decidePrime tests a binary number by binary long division (sub, divPos) by every d below a power of two B
-- with B <= n < B * B; the d with B <= d < n are covered by an erased argument (extend, bigDivisor) that such a
-- d dividing n would have a cofactor in [2, B). All Nat-level data and evidence is erased, so evaluation is
-- meant to do only binary work, at most about 2 * sqrt(n) trial divisions; the comptime let at the end uses it to
-- prove 999983 prime, and the print shows None for 988027 = 991 * 997.

data Nat() : Type() {
  Zero() : Nat();
  Succ(pred : Nat()) : Nat();
}

data Eq(A : Type(), x : A, y : A) : Type() {
  Refl(erased A : Type(), erased x : A) : Eq(A, x, x);
}

data False() : Type() {}

data Or(A : Type(), B : Type()) : Type() {
  Inl(erased A : Type(), erased B : Type(), x : A) : Or(A, B);
  Inr(erased A : Type(), erased B : Type(), y : B) : Or(A, B);
}

data Option(A : Type()) : Type() {
  None(erased A : Type()) : Option(A);
  Some(erased A : Type(), erased x : A) : Option(A);
}

data NonZero(n : Nat()) : Type() {
  NonZeroSucc(erased n : Nat()) : NonZero(Succ(n));
}

data Plus(m : Nat(), n : Nat(), r : Nat()) : Type() {
  PlusZero(erased n : Nat()) : Plus(Zero(), n, n);
  PlusSucc(erased m : Nat(), erased n : Nat(), erased r : Nat(), p : Plus(m, n, r)) : Plus(Succ(m), n, Succ(r));
}

data Times(m : Nat(), n : Nat(), r : Nat()) : Type() {
  TimesZero(erased n : Nat()) : Times(Zero(), n, Zero());
  TimesSucc(erased m : Nat(), erased n : Nat(), erased r : Nat(), erased s : Nat(),
      t : Times(m, n, r), p : Plus(r, n, s)) : Times(Succ(m), n, s);
}

data Cmp(m : Nat(), n : Nat()) : Type() {
  CmpGe(erased m : Nat(), erased n : Nat(), erased k : Nat(), p : Plus(n, k, m)) : Cmp(m, n);
  CmpLt(erased m : Nat(), erased n : Nat(), erased k : Nat(), p : Plus(Succ(m), k, n)) : Cmp(m, n);
}

data DivMod(n : Nat(), d : Nat(), q : Nat(), r : Nat()) : Type() {
  DivModIntro(erased n : Nat(), erased d : Nat(), erased q : Nat(), erased r : Nat(), erased t : Nat(),
      erased k : Nat(), tq : Times(q, d, t), s : Plus(t, r, n), l : Plus(Succ(r), k, d)) : DivMod(n, d, q, r);
}

data NotDivides(d : Nat(), n : Nat()) : Type() {
  NotDiv(erased d : Nat(), erased n : Nat(), erased q : Nat(), erased r : Nat(), m : DivMod(n, d, q, Succ(r)))
    : NotDivides(d, n);
}

data NoDivBelow(n : Nat(), k : Nat()) : Type() {
  NoDivTwo(erased n : Nat()) : NoDivBelow(n, Succ(Succ(Zero())));
  NoDivStep(erased n : Nat(), erased k : Nat(), rest : NoDivBelow(n, k), nd : NotDivides(k, n))
    : NoDivBelow(n, Succ(k));
}

data Prime(n : Nat()) : Type() {
  PrimeIntro(erased n : Nat(), nd : NoDivBelow(n, n)) : Prime(n);
}

data Pos() : Type() {
  One() : Pos();
  P0(p : Pos()) : Pos();
  P1(p : Pos()) : Pos();
}

data Bin() : Type() {
  BZ() : Bin();
  BP(p : Pos()) : Bin();
}

data PosRep(p : Pos(), n : Nat()) : Type() {
  RepOne() : PosRep(One(), Succ(Zero()));
  RepP0(erased p : Pos(), erased n : Nat(), erased d : Nat(), r : PosRep(p, n), s : Plus(n, n, d)) : PosRep(P0(p), d);
  RepP1(erased p : Pos(), erased n : Nat(), erased d : Nat(), r : PosRep(p, n), s : Plus(n, n, d))
    : PosRep(P1(p), Succ(d));
}

data Rep(b : Bin(), n : Nat()) : Type() {
  RepZ() : Rep(BZ(), Zero());
  RepP(erased p : Pos(), erased n : Nat(), r : PosRep(p, n)) : Rep(BP(p), n);
}

data Diff(m : Nat(), n : Nat()) : Type() {
  Above(z : Bin(), erased m : Nat(), erased n : Nat(), erased k : Nat(), erased r : Rep(z, k),
      erased p : Plus(n, k, m)) : Diff(m, n);
  Below(erased m : Nat(), erased n : Nat(), erased k : Nat(), erased p : Plus(Succ(m), k, n)) : Diff(m, n);
}

data Shift(m : Nat(), j : Nat(), c : Nat()) : Type() {
  ShiftZ(erased m : Nat()) : Shift(m, Zero(), m);
  ShiftS(erased m : Nat(), erased j : Nat(), erased m2 : Nat(), erased c : Nat(), d : Plus(m, m, m2),
      s : Shift(m2, j, c)) : Shift(m, Succ(j), c);
}

data Reach(n : Nat(), m : Nat(), j : Nat()) : Type() {
  ReachIntro(erased n : Nat(), erased m : Nat(), erased j : Nat(), erased e : Nat(), s : Shift(m, j, e),
      nd : NoDivBelow(n, e)) : Reach(n, m, j);
}

goal fn (erased n : Nat(), erased a : Nat(), erased b : Nat(), erased p : Prime(n), erased t : Times(a, b, n))
    -> (erased o : Or(Eq(Nat(), a, Succ(Zero())), Eq(Nat(), b, Succ(Zero()))));

fn plus(subterm m : Nat(), n : Nat()) -> (erased r : Nat(), erased p : Plus(m, n, r)) {
  match m : _ {
    Zero() => (n, PlusZero(_));
    Succ(k) => {
      let (erased r, erased p) = plus(subterm k, n);
      (Succ(r), PlusSucc(_, _, _, p))
    };
  }
}

fn plusZeroRight(subterm n : Nat()) -> (erased p : Plus(n, Zero(), n)) {
  match n : _ {
    Zero() => PlusZero(_);
    Succ(k) => PlusSucc(_, _, _, plusZeroRight(subterm k));
  }
}

fn plusSucc(erased m : Nat(), erased n : Nat(), erased r : Nat(), subterm p : Plus(m, n, r))
    -> (erased q : Plus(m, Succ(n), Succ(r))) {
  match p : _ {
    PlusZero(_) => PlusZero(_);
    PlusSucc(_, _, _, p1) => PlusSucc(_, _, _, plusSucc(_, _, _, subterm p1));
  }
}

fn plusComm(erased m : Nat(), erased n : Nat(), erased r : Nat(), subterm p : Plus(m, n, r))
    -> (erased q : Plus(n, m, r)) {
  match p : _ {
    PlusZero(_) => plusZeroRight(n);
    PlusSucc(_, _, _, p1) => plusSucc(_, _, _, plusComm(_, _, _, subterm p1));
  }
}

fn plusAssoc(erased a : Nat(), erased b : Nat(), erased c : Nat(), erased ab : Nat(), erased r : Nat(),
    subterm p : Plus(a, b, ab), q : Plus(ab, c, r))
    -> (erased bc : Nat(), erased q1 : Plus(b, c, bc), erased q2 : Plus(a, bc, r)) {
  match p : _ {
    PlusZero(_) => (r, q, PlusZero(_));
    PlusSucc(_, _, _, p1) => {
      let PlusSucc(_, _, _, q3) = q;
      let (erased bc, erased s1, erased s2) = plusAssoc(_, _, _, _, _, subterm p1, q3);
      (bc, s1, PlusSucc(_, _, _, s2))
    };
  }
}

fn plusAssocRev(erased a : Nat(), erased b : Nat(), erased c : Nat(), erased bc : Nat(), erased r : Nat(),
    p : Plus(b, c, bc), subterm q : Plus(a, bc, r))
    -> (erased ab : Nat(), erased q1 : Plus(a, b, ab), erased q2 : Plus(ab, c, r)) {
  match q : _ {
    PlusZero(_) => (b, PlusZero(_), p);
    PlusSucc(_, _, _, q3) => {
      let (erased ab, erased s1, erased s2) = plusAssocRev(_, _, _, _, _, p, subterm q3);
      (Succ(ab), PlusSucc(_, _, _, s1), PlusSucc(_, _, _, s2))
    };
  }
}

fn exchange(erased w : Nat(), erased y : Nat(), erased x : Nat(), erased z : Nat(), erased wy : Nat(),
    erased xz : Nat(), erased r : Nat(), p : Plus(w, y, wy), q : Plus(x, z, xz), s : Plus(wy, xz, r))
    -> (erased wx : Nat(), erased yz : Nat(), erased p1 : Plus(w, x, wx), erased q1 : Plus(y, z, yz),
        erased s1 : Plus(wx, yz, r)) {
  let (erased yxz, erased s2, erased s3) = plusAssoc(_, _, _, _, _, p, s);
  let (erased yx, erased s4, erased s5) = plusAssocRev(_, _, _, _, _, q, s2);
  let (erased yz, erased s7, erased s8) = plusAssoc(_, _, _, _, _, plusComm(_, _, _, s4), s5);
  let (erased wx, erased s9, erased s10) = plusAssocRev(_, _, _, _, _, s8, s3);
  (wx, yz, s9, s7, s10)
}

fn plusFunc(erased a : Nat(), erased b : Nat(), erased c : Nat(), erased d : Nat(),
    subterm p : Plus(a, b, c), q : Plus(a, b, d)) -> (erased e : Eq(Nat(), c, d)) {
  match p : _ {
    PlusZero(_) => {
      let PlusZero(_) = q;
      Refl(_, _)
    };
    PlusSucc(_, _, _, p1) => {
      let PlusSucc(_, _, _, q1) = q;
      match erased plusFunc(_, _, _, _, subterm p1, q1) : _ {
        Refl(_, _) => Refl(_, _);
      }
    };
  }
}

fn plusCancel(erased a : Nat(), erased b : Nat(), erased c : Nat(), erased d : Nat(),
    subterm p : Plus(a, b, c), q : Plus(a, d, c)) -> (erased e : Eq(Nat(), b, d)) {
  match p : _ {
    PlusZero(_) => {
      let PlusZero(_) = q;
      Refl(_, _)
    };
    PlusSucc(_, _, _, p1) => {
      let PlusSucc(_, _, _, q1) = q;
      plusCancel(_, _, _, _, subterm p1, q1)
    };
  }
}

fn plusMove(erased a : Nat(), erased b : Nat(), erased c : Nat(), p : Plus(Succ(a), b, c))
    -> (erased q : Plus(a, Succ(b), c)) {
  let PlusSucc(_, _, _, p1) = p;
  plusSucc(_, _, _, p1)
}

fn plusMoveBack(erased a : Nat(), erased b : Nat(), erased c : Nat(), p : Plus(a, Succ(b), c))
    -> (erased q : Plus(Succ(a), b, c)) {
  let erased PlusSucc(_, _, _, p1) = plusComm(_, _, _, p);
  PlusSucc(_, _, _, plusComm(_, _, _, p1))
}

fn succBoth(erased a : Nat(), erased b : Nat(), erased c : Nat(), p : Plus(a, b, c))
    -> (erased q : Plus(Succ(a), Succ(b), Succ(Succ(c)))) {
  PlusSucc(_, _, _, plusSucc(_, _, _, p))
}

fn noGrow(erased a : Nat(), erased b : Nat(), subterm p : Plus(a, Succ(b), a)) -> (erased f : False()) {
  match p : _ {
    PlusSucc(_, _, _, p1) => noGrow(_, _, subterm p1);
  }
}

fn antisym(erased a : Nat(), erased b : Nat(), erased i : Nat(), erased w : Nat(), p : Plus(a, i, b),
    q : Plus(b, Succ(w), a)) -> (erased f : False()) {
  let (erased c, erased p1, erased p2) = plusAssoc(_, _, _, _, _, p, q);
  let erased PlusSucc(_, _, _, _) = plusComm(_, _, _, p1);
  noGrow(_, _, p2)
}

fn compare(subterm m : Nat(), n : Nat()) -> (erased o : Cmp(m, n)) {
  match m : _ {
    Zero() => match n : _ {
      Zero() => CmpGe(_, _, Zero(), PlusZero(_));
      Succ(n1) => CmpLt(_, _, n1, PlusSucc(_, _, _, PlusZero(_)));
    };
    Succ(m1) => match n : _ {
      Zero() => CmpGe(_, _, m, PlusZero(_));
      Succ(n1) => match erased compare(subterm m1, n1) : _ {
        CmpGe(_, _, k, p) => CmpGe(_, _, k, PlusSucc(_, _, _, p));
        CmpLt(_, _, k, p) => CmpLt(_, _, k, PlusSucc(_, _, _, p));
      };
    };
  }
}

fn dsum(erased a : Nat(), erased b : Nat(), erased r : Nat(), erased ma : Nat(), erased nb : Nat(),
    erased mr : Nat(), p : Plus(a, b, r), pa : Plus(a, a, ma), pb : Plus(b, b, nb), pr : Plus(r, r, mr))
    -> (erased q : Plus(ma, nb, mr)) {
  let (erased d, erased s) = plus(ma, nb);
  let (erased wx, erased yz, erased p1, erased p2, erased q) = exchange(_, _, _, _, _, _, _, pa, pb, s);
  match erased plusFunc(_, _, _, _, p1, p) : _ {
    Refl(_, _) => match erased plusFunc(_, _, _, _, p2, p) : _ {
      Refl(_, _) => match erased plusFunc(_, _, _, _, q, pr) : _ {
        Refl(_, _) => s;
      };
    };
  }
}

fn ltDouble(erased a : Nat(), erased b : Nat(), erased k : Nat(), erased a2 : Nat(), erased b2 : Nat(),
    l : Plus(Succ(a), k, b), sa : Plus(a, a, a2), sb : Plus(b, b, b2))
    -> (erased w : Nat(), erased p : Plus(Succ(Succ(a2)), w, b2)) {
  let (erased w, erased sk) = plus(k, k);
  (w, dsum(_, _, _, _, _, _, l, succBoth(_, _, _, sa), sk, sb))
}

fn timesZeroRight(subterm m : Nat()) -> (erased t : Times(m, Zero(), Zero())) {
  match m : _ {
    Zero() => TimesZero(_);
    Succ(k) => TimesSucc(_, _, _, _, timesZeroRight(subterm k), PlusZero(_));
  }
}

fn timesPlusLeft(erased a : Nat(), erased b : Nat(), erased c : Nat(), erased n : Nat(), erased ta : Nat(),
    erased tb : Nat(), erased t : Nat(), subterm p : Plus(a, b, c), t1 : Times(a, n, ta), t2 : Times(b, n, tb),
    q : Plus(ta, tb, t)) -> (erased u : Times(c, n, t)) {
  match p : _ {
    PlusZero(_) => {
      let TimesZero(_) = t1;
      let PlusZero(_) = q;
      t2
    };
    PlusSucc(_, _, _, p1) => {
      let TimesSucc(_, _, _, _, t3, s1) = t1;
      let (erased ntb, erased s2, erased s3) = plusAssoc(_, _, _, _, _, s1, q);
      let (erased x, erased s4, erased s5) = plusAssocRev(_, _, _, _, _, plusComm(_, _, _, s2), s3);
      TimesSucc(_, _, _, _, timesPlusLeft(_, _, _, _, _, _, _, subterm p1, t3, t2, s4), s5)
    };
  }
}

fn timesDouble(erased a : Nat(), erased ma : Nat(), erased n : Nat(), erased t : Nat(),
    sa : Plus(a, a, ma), u : Times(a, n, t))
    -> (erased d : Nat(), erased q : Plus(t, t, d), erased v : Times(ma, n, d)) {
  let (erased d, erased q) = plus(t, t);
  (d, q, timesPlusLeft(_, _, _, _, _, _, _, sa, u, u, q))
}

fn timesSplit(erased a : Nat(), erased k : Nat(), erased a2 : Nat(), erased d : Nat(), erased n : Nat(),
    subterm p : Plus(a, k, a2), t : Times(a2, d, n))
    -> (erased x : Nat(), erased y : Nat(), erased tx : Times(a, d, x), erased ty : Times(k, d, y),
        erased s : Plus(x, y, n)) {
  match p : _ {
    PlusZero(_) => (Zero(), n, TimesZero(_), t, PlusZero(_));
    PlusSucc(_, _, _, p1) => {
      let TimesSucc(_, _, _, _, t1, q) = t;
      let (erased x, erased y, erased tx, erased ty, erased s) = timesSplit(_, _, _, _, _, subterm p1, t1);
      let (erased yd, erased s2, erased s3) = plusAssoc(_, _, _, _, _, s, q);
      let (erased x1, erased s4, erased s5) = plusAssocRev(_, _, _, _, _, plusComm(_, _, _, s2), s3);
      (x1, y, TimesSucc(_, _, _, _, tx, s4), ty, s5)
    };
  }
}

fn timesFunc(erased a : Nat(), erased b : Nat(), erased x : Nat(), erased y : Nat(),
    subterm t : Times(a, b, x), u : Times(a, b, y)) -> (erased e : Eq(Nat(), x, y)) {
  match t : _ {
    TimesZero(_) => {
      let TimesZero(_) = u;
      Refl(_, _)
    };
    TimesSucc(_, _, _, _, t1, p1) => {
      let TimesSucc(_, _, _, _, u1, q1) = u;
      match erased timesFunc(_, _, _, _, subterm t1, u1) : _ {
        Refl(_, _) => plusFunc(_, _, _, _, p1, q1);
      }
    };
  }
}

fn timesSuccRight(erased a : Nat(), erased b : Nat(), erased n : Nat(), subterm t : Times(a, b, n))
    -> (erased r : Nat(), erased u : Times(a, Succ(b), r), erased p : Plus(n, a, r)) {
  match t : _ {
    TimesZero(_) => (Zero(), TimesZero(_), PlusZero(_));
    TimesSucc(_, _, _, _, t1, p1) => {
      let (erased r1, erased u1, erased q1) = timesSuccRight(_, _, _, subterm t1);
      let (erased r, erased q2) = plus(r1, Succ(b));
      let (erased x, erased q3, erased q4) = plusAssoc(_, _, _, _, _, q1, q2);
      let erased PlusSucc(_, _, _, q5) = plusComm(_, _, _, q3);
      let (erased y, erased q6, erased q7) = plusAssocRev(_, _, _, _, _, plusSucc(_, _, _, q5), q4);
      match erased plusFunc(_, _, _, _, q6, p1) : _ {
        Refl(_, _) => (r, TimesSucc(_, _, _, _, u1, q2), q7);
      }
    };
  }
}

fn timesComm(erased a : Nat(), erased b : Nat(), erased n : Nat(), subterm t : Times(a, b, n))
    -> (erased u : Times(b, a, n)) {
  match t : _ {
    TimesZero(_) => timesZeroRight(b);
    TimesSucc(_, _, _, _, t1, p1) => {
      let (erased r, erased u1, erased q1) = timesSuccRight(_, _, _, timesComm(_, _, _, subterm t1));
      match erased plusFunc(_, _, _, _, q1, p1) : _ {
        Refl(_, _) => u1;
      }
    };
  }
}

fn divmod(subterm n : Nat(), d : Nat(), z : NonZero(d))
    -> (erased q : Nat(), erased r : Nat(), erased dm : DivMod(n, d, q, r)) {
  match n : _ {
    Zero() => {
      let NonZeroSucc(d1) = z;
      (Zero(), Zero(), DivModIntro(_, _, _, _, Zero(), d1, TimesZero(_), PlusZero(_), PlusSucc(_, _, _, PlusZero(_))))
    };
    Succ(n1) => {
      let (erased q, erased r, erased dm) = divmod(subterm n1, d, z);
      let erased DivModIntro(_, _, _, _, t, _, tq, s, l) = dm;
      match erased plusComm(_, _, _, l) : _ {
        PlusZero(_) => (Succ(q), Zero(), DivModIntro(_, _, _, _, n, r, TimesSucc(_, _, _, _, tq, plusSucc(_, _, _, s)),
          plusZeroRight(n), PlusSucc(_, _, _, PlusZero(_))));
        PlusSucc(k1, _, _, l1) => (q, Succ(r), DivModIntro(_, _, _, _, t, k1, tq, plusSucc(_, _, _, s),
          PlusSucc(_, _, _, plusComm(_, _, _, l1))));
      }
    };
  }
}

fn ndTwo(erased n : Nat(), erased k : Nat(), subterm nd : NoDivBelow(n, k))
    -> (erased j : Nat(), erased e : Eq(Nat(), k, Succ(Succ(j)))) {
  match nd : _ {
    NoDivTwo(_) => (Zero(), Refl(_, _));
    NoDivStep(_, _, rest, _) => {
      let (erased j, erased e) = ndTwo(_, _, subterm rest);
      match erased e : _ {
        Refl(_, _) => (Succ(j), Refl(_, _));
      }
    };
  }
}

fn lookup(erased n : Nat(), erased d : Nat(), erased k : Nat(), erased j : Nat(), subterm nd : NoDivBelow(n, k),
    p : Plus(Succ(Succ(Succ(d))), j, k)) -> (erased r : NotDivides(Succ(Succ(d)), n)) {
  match nd : _ {
    NoDivTwo(_) => {
      let PlusSucc(_, _, _, p1) = p;
      let PlusSucc(_, _, _, p2) = p1;
      match p2 : _ {}
    };
    NoDivStep(_, _, rest, nd1) => {
      let PlusSucc(_, _, _, p1) = p;
      match erased plusComm(_, _, _, p1) : _ {
        PlusZero(_) => nd1;
        PlusSucc(_, _, _, p2) => lookup(_, _, _, _, subterm rest, PlusSucc(_, _, _, plusComm(_, _, _, p2)));
      }
    };
  }
}

fn divUniqueFalse(erased n : Nat(), erased d : Nat(), erased q : Nat(), erased r : Nat(), erased a : Nat(),
    dm : DivMod(n, d, q, Succ(r)), t : Times(a, d, n)) -> (erased f : False()) {
  let DivModIntro(_, _, _, _, _, _, tq, s, l) = dm;
  match erased compare(a, q) : _ {
    CmpGe(_, _, _, p) => {
      let (erased x, erased y, erased tx, erased ty, erased sxy) = timesSplit(_, _, _, _, _, p, t);
      match erased timesFunc(_, _, _, _, tq, tx) : _ {
        Refl(_, _) => match erased plusCancel(_, _, _, _, s, sxy) : _ {
          Refl(_, _) => {
            let erased TimesSucc(_, _, _, _, _, pu) = ty;
            antisym(_, _, _, _, plusComm(_, _, _, pu), plusMove(_, _, _, l))
          };
        };
      }
    };
    CmpLt(_, _, _, p) => {
      let (erased x, erased y, erased tx, erased ty, erased sxy) = timesSplit(_, _, _, _, _, p, tq);
      let erased TimesSucc(_, _, _, _, tu, pu) = tx;
      match erased timesFunc(_, _, _, _, t, tu) : _ {
        Refl(_, _) => {
          let (erased z, erased p1, erased p2) = plusAssoc(_, _, _, _, _, pu, sxy);
          antisym(_, _, _, _, p2, s)
        };
      }
    };
  }
}

fn noFactor(erased n : Nat(), erased d : Nat(), erased k : Nat(), erased j : Nat(), erased a : Nat(),
    nd : NoDivBelow(n, k), p : Plus(Succ(Succ(Succ(d))), j, k), t : Times(a, Succ(Succ(d)), n))
    -> (erased f : False()) {
  let erased NotDiv(_, _, _, _, dm) = lookup(_, _, _, _, nd, p);
  divUniqueFalse(_, _, _, _, _, dm, t)
}

fn primeFactor(erased n : Nat(), erased a : Nat(), erased b : Nat(), erased p : Prime(n), erased t : Times(a, b, n))
    -> (erased o : Or(Eq(Nat(), a, Succ(Zero())), Eq(Nat(), b, Succ(Zero())))) {
  let erased PrimeIntro(_, nd) = p;
  let (erased n2, erased e) = ndTwo(_, _, nd);
  match erased e : _ {
    Refl(_, _) => match erased b : _ {
      Zero() => match erased timesFunc(_, _, _, _, t, timesZeroRight(a)) : _ {};
      Succ(b1) => match erased b1 : _ {
        Zero() => Inr(_, _, Refl(Nat(), b));
        Succ(b2) => match erased compare(b, n) : _ {
          CmpLt(_, _, _, lt) => match erased noFactor(_, _, _, _, _, nd, lt, t) : _ {};
          CmpGe(_, _, _, ge) => match erased a : _ {
            Zero() => match erased t : _ {};
            Succ(a1) => match erased a1 : _ {
              Zero() => Inl(_, _, Refl(Nat(), a));
              Succ(a2) => {
                let erased TimesSucc(_, _, _, _, t1, p1) = t;
                let erased TimesSucc(_, _, _, _, _, p2) = t1;
                let erased PlusSucc(_, _, _, _) = plusComm(_, _, _, p2);
                match erased antisym(_, _, _, _, ge, plusComm(_, _, _, p1)) : _ {}
              };
            };
          };
        };
      };
    };
  }
}

qed primeFactor;

fn bigDivisor(erased n : Nat(), erased c : Nat(), erased b : Nat(), erased bb : Nat(), erased w : Nat(),
    erased l : Nat(), erased k : Nat(), erased q : Nat(), lb : Plus(b, l, c), cn : Plus(Succ(c), k, n),
    nd : NoDivBelow(n, b), tb : Times(b, b, bb), lt : Plus(Succ(n), w, bb), tq : Times(q, c, n))
    -> (erased f : False()) {
  match erased compare(q, b) : _ {
    CmpGe(_, _, _, p) => {
      let (erased x, erased y, erased tx, erased ty, erased s) = timesSplit(_, _, _, _, _, p, tq);
      let (erased x1, erased y1, erased tx1, erased ty1, erased s1) =
        timesSplit(_, _, _, _, _, lb, timesComm(_, _, _, tx));
      match erased timesFunc(_, _, _, _, tb, tx1) : _ {
        Refl(_, _) => {
          let (erased z, erased p1, erased p2) = plusAssoc(_, _, _, _, _, s1, s);
          antisym(_, _, _, _, p2, plusMove(_, _, _, lt))
        };
      }
    };
    CmpLt(_, _, _, p) => match erased q : _ {
      Zero() => {
        let erased TimesZero(_) = tq;
        match erased cn : _ {}
      };
      Succ(q1) => match erased q1 : _ {
        Zero() => {
          let erased TimesSucc(_, _, _, _, t1, p1) = tq;
          let erased TimesZero(_) = t1;
          let erased PlusZero(_) = p1;
          noGrow(_, _, plusMove(_, _, _, cn))
        };
        Succ(q2) => noFactor(_, _, _, _, _, nd, p, timesComm(_, _, _, tq));
      };
    };
  }
}

fn notDivLarge(erased n : Nat(), erased c : Nat(), erased b : Nat(), erased bb : Nat(), erased w : Nat(),
    erased l : Nat(), erased k : Nat(), lb : Plus(b, l, c), cn : Plus(Succ(c), k, n), nd : NoDivBelow(n, b),
    tb : Times(b, b, bb), lt : Plus(Succ(n), w, bb)) -> (erased r : NotDivides(c, n)) {
  let (erased j, erased e) = ndTwo(_, _, nd);
  match erased e : _ {
    Refl(_, _) => {
      let erased PlusSucc(_, _, _, _) = lb;
      let (erased q, erased r, erased dm) = divmod(n, c, NonZeroSucc(_));
      match erased r : _ {
        Zero() => {
          let erased DivModIntro(_, _, _, _, t, _, tq, s, _) = dm;
          match erased plusFunc(_, _, _, _, plusZeroRight(t), s) : _ {
            Refl(_, _) => match erased bigDivisor(_, _, _, _, _, _, _, _, lb, cn, nd, tb, lt, tq) : _ {};
          }
        };
        Succ(r1) => NotDiv(_, _, _, _, dm);
      }
    };
  }
}

fn extend(subterm k : Nat(), erased n : Nat(), erased c : Nat(), erased b : Nat(), erased bb : Nat(),
    erased w : Nat(), erased l : Nat(), nd : NoDivBelow(n, c), p : Plus(c, k, n), lb : Plus(b, l, c),
    nd0 : NoDivBelow(n, b), tb : Times(b, b, bb), lt : Plus(Succ(n), w, bb)) -> (erased r : NoDivBelow(n, n)) {
  match k : _ {
    Zero() => match erased plusFunc(_, _, _, _, plusZeroRight(c), p) : _ {
      Refl(_, _) => nd;
    };
    Succ(k1) => {
      let (erased cn) = plusMoveBack(_, _, _, p);
      extend(subterm k1, _, _, _, _, _, _, NoDivStep(_, _, nd, notDivLarge(_, _, _, _, _, _, _, lb, cn, nd0, tb, lt)),
        cn, plusSucc(_, _, _, lb), nd0, tb, lt)
    };
  }
}

fn shiftFunc(erased m : Nat(), erased j : Nat(), erased c : Nat(), erased d : Nat(), subterm s : Shift(m, j, c),
    u : Shift(m, j, d)) -> (erased e : Eq(Nat(), c, d)) {
  match s : _ {
    ShiftZ(_) => {
      let ShiftZ(_) = u;
      Refl(_, _)
    };
    ShiftS(_, _, _, _, p, s1) => {
      let ShiftS(_, _, _, _, q, u1) = u;
      match erased plusFunc(_, _, _, _, p, q) : _ {
        Refl(_, _) => shiftFunc(_, _, _, _, subterm s1, u1);
      }
    };
  }
}

fn shiftDouble(erased a : Nat(), erased j : Nat(), erased x : Nat(), erased a2 : Nat(), erased x2 : Nat(),
    subterm s : Shift(a, j, x), sa : Plus(a, a, a2), sx : Plus(x, x, x2)) -> (erased u : Shift(a2, j, x2)) {
  match s : _ {
    ShiftZ(_) => match erased plusFunc(_, _, _, _, sa, sx) : _ {
      Refl(_, _) => ShiftZ(_);
    };
    ShiftS(_, _, am, _, p, s1) => {
      let (erased am2, erased q) = plus(am, am);
      ShiftS(_, _, _, _, dsum(_, _, _, _, _, _, p, sa, sa, q), shiftDouble(_, _, _, _, _, subterm s1, q, sx))
    };
  }
}

fn posPos(erased x : Pos(), erased k : Nat(), subterm r : PosRep(x, k)) -> (erased z : NonZero(k)) {
  match r : _ {
    RepOne() => NonZeroSucc(_);
    RepP0(_, _, _, r1, s) => {
      let erased NonZeroSucc(_) = posPos(_, _, subterm r1);
      let PlusSucc(_, _, _, _) = s;
      NonZeroSucc(_)
    };
    RepP1(_, _, _, _, _) => NonZeroSucc(_);
  }
}

fn atLeastTwo(erased b : Pos(), erased nb : Nat(), erased d : Nat(), rb : PosRep(b, nb), sb : Plus(nb, nb, d))
    -> (erased w : Nat(), erased p : Plus(Succ(Succ(Zero())), w, d)) {
  let erased NonZeroSucc(_) = posPos(_, _, rb);
  ltDouble(_, _, _, _, _, PlusSucc(_, _, _, PlusZero(_)), PlusZero(_), sb)
}

fn toNatPos(subterm x : Pos()) -> (erased n : Nat(), erased r : PosRep(x, n)) {
  match x : _ {
    One() => (Succ(Zero()), RepOne());
    P0(a) => {
      let (erased k, erased r) = toNatPos(subterm a);
      let (erased d, erased s) = plus(k, k);
      (d, RepP0(_, _, _, r, s))
    };
    P1(a) => {
      let (erased k, erased r) = toNatPos(subterm a);
      let (erased d, erased s) = plus(k, k);
      (Succ(d), RepP1(_, _, _, r, s))
    };
  }
}

fn toNat(b : Bin()) -> (erased n : Nat(), erased r : Rep(b, n)) {
  match b : _ {
    BZ() => (Zero(), RepZ());
    BP(p) => {
      let (erased n, erased r) = toNatPos(p);
      (n, RepP(_, _, r))
    };
  }
}

fn succPos(erased m : Nat(), subterm x : Pos(), erased px : PosRep(x, m))
    -> (z : Pos(), erased pz : PosRep(z, Succ(m))) {
  match x : _ {
    One() => {
      let erased RepOne() = px;
      (P0(One()), RepP0(_, _, _, RepOne(), PlusSucc(_, _, _, PlusZero(_))))
    };
    P0(a) => {
      let erased RepP0(_, _, _, ra, sa) = px;
      (P1(a), RepP1(_, _, _, ra, sa))
    };
    P1(a) => {
      let erased RepP1(_, _, _, ra, sa) = px;
      let (z, erased pz) = succPos(_, subterm a, ra);
      (P0(z), RepP0(_, _, _, pz, succBoth(_, _, _, sa)))
    };
  }
}

fn inc(erased n : Nat(), b : Bin(), erased pb : Rep(b, n)) -> (c : Bin(), erased pc : Rep(c, Succ(n))) {
  match b : _ {
    BZ() => {
      let erased RepZ() = pb;
      (BP(One()), RepP(_, _, RepOne()))
    };
    BP(p) => {
      let erased RepP(_, _, r) = pb;
      let (q, erased pq) = succPos(_, p, r);
      (BP(q), RepP(_, _, pq))
    };
  }
}

fn twice(erased k : Nat(), erased d : Nat(), z : Bin(), erased r : Rep(z, k), erased s : Plus(k, k, d))
    -> (w : Bin(), erased rw : Rep(w, d)) {
  match z : _ {
    BZ() => {
      let erased RepZ() = r;
      let erased PlusZero(_) = s;
      (BZ(), RepZ())
    };
    BP(p) => {
      let erased RepP(_, _, rp) = r;
      (BP(P0(p)), RepP(_, _, RepP0(_, _, _, rp, s)))
    };
  }
}

fn twice1(erased k : Nat(), erased d : Nat(), z : Bin(), erased r : Rep(z, k), erased s : Plus(k, k, d))
    -> (w : Bin(), erased rw : Rep(w, Succ(d))) {
  match z : _ {
    BZ() => {
      let erased RepZ() = r;
      let erased PlusZero(_) = s;
      (BP(One()), RepP(_, _, RepOne()))
    };
    BP(p) => {
      let erased RepP(_, _, rp) = r;
      (BP(P1(p)), RepP(_, _, RepP1(_, _, _, rp, s)))
    };
  }
}

fn lift00(erased a : Nat(), erased b : Nat(), erased da : Nat(), erased db : Nat(), x : Diff(a, b),
    erased sa : Plus(a, a, da), erased sb : Plus(b, b, db)) -> (y : Diff(da, db)) {
  match x : _ {
    Above(z, _, _, k, rz, p) => {
      let (erased dk, erased sk) = plus(k, k);
      let (w, erased rw) = twice(_, _, z, rz, sk);
      Above(w, _, _, dk, rw, dsum(_, _, _, _, _, _, p, sb, sk, sa))
    };
    Below(_, _, _, p) => {
      let (erased w, erased q) = ltDouble(_, _, _, _, _, p, sa, sb);
      Below(_, _, Succ(w), plusMove(_, _, _, q))
    };
  }
}

fn lift11(erased a : Nat(), erased b : Nat(), erased da : Nat(), erased db : Nat(), x : Diff(a, b),
    erased sa : Plus(a, a, da), erased sb : Plus(b, b, db)) -> (y : Diff(Succ(da), Succ(db))) {
  match lift00(_, _, _, _, x, sa, sb) : _ {
    Above(z, _, _, k, rz, p) => Above(z, _, _, k, rz, PlusSucc(_, _, _, p));
    Below(_, _, k, p) => Below(_, _, k, PlusSucc(_, _, _, p));
  }
}

fn lift10(erased a : Nat(), erased b : Nat(), erased da : Nat(), erased db : Nat(), x : Diff(a, b),
    erased sa : Plus(a, a, da), erased sb : Plus(b, b, db)) -> (y : Diff(Succ(da), db)) {
  match x : _ {
    Above(z, _, _, k, rz, p) => {
      let (erased dk, erased sk) = plus(k, k);
      let (w, erased rw) = twice1(_, _, z, rz, sk);
      Above(w, _, _, Succ(dk), rw, plusSucc(_, _, _, dsum(_, _, _, _, _, _, p, sb, sk, sa)))
    };
    Below(_, _, _, p) => {
      let (erased w, erased q) = ltDouble(_, _, _, _, _, p, sa, sb);
      Below(_, _, w, q)
    };
  }
}

fn lift01(erased a : Nat(), erased b : Nat(), erased da : Nat(), erased db : Nat(), x : Diff(a, Succ(b)),
    erased sa : Plus(a, a, da), erased sb : Plus(b, b, db)) -> (y : Diff(da, Succ(db))) {
  match x : _ {
    Above(z, _, _, k, rz, p) => {
      let (erased dk, erased sk) = plus(k, k);
      let (w, erased rw) = twice1(_, _, z, rz, sk);
      Above(w, _, _, Succ(dk), rw, plusMove(_, _, _, dsum(_, _, _, _, _, _, p, succBoth(_, _, _, sb), sk, sa)))
    };
    Below(_, _, _, p) => {
      let (erased w, erased q) = ltDouble(_, _, _, _, _, p, sa, succBoth(_, _, _, sb));
      let erased PlusSucc(_, _, _, q1) = q;
      Below(_, _, w, q1)
    };
  }
}

fn sub(erased m : Nat(), erased n : Nat(), subterm x : Pos(), y : Bin(), erased px : PosRep(x, m),
    erased py : Rep(y, n)) -> (r : Diff(m, n)) {
  match x : _ {
    One() => {
      let erased RepOne() = px;
      match y : _ {
        BZ() => {
          let erased RepZ() = py;
          Above(BP(One()), _, _, Succ(Zero()), RepP(_, _, RepOne()), PlusZero(_))
        };
        BP(q) => {
          let erased RepP(_, _, rq) = py;
          match q : _ {
            One() => {
              let erased RepOne() = rq;
              Above(BZ(), _, _, Zero(), RepZ(), plusZeroRight(Succ(Zero())))
            };
            P0(b) => {
              let erased RepP0(_, _, _, rb, sb) = rq;
              let (erased w, erased p) = atLeastTwo(_, _, _, rb, sb);
              Below(_, _, w, p)
            };
            P1(b) => {
              let erased RepP1(_, _, _, rb, sb) = rq;
              let (erased w, erased p) = atLeastTwo(_, _, _, rb, sb);
              Below(_, _, Succ(w), plusSucc(_, _, _, p))
            };
          }
        };
      }
    };
    P0(a) => {
      let erased RepP0(_, _, _, ra, sa) = px;
      match y : _ {
        BZ() => {
          let erased RepZ() = py;
          Above(BP(x), _, _, m, RepP(_, _, px), PlusZero(_))
        };
        BP(q) => {
          let erased RepP(_, _, rq) = py;
          match q : _ {
            One() => {
              let erased RepOne() = rq;
              lift01(_, _, _, _, sub(_, _, subterm a, BP(One()), ra, RepP(_, _, RepOne())), sa, PlusZero(_))
            };
            P0(b) => {
              let erased RepP0(_, _, _, rb, sb) = rq;
              lift00(_, _, _, _, sub(_, _, subterm a, BP(b), ra, RepP(_, _, rb)), sa, sb)
            };
            P1(b) => {
              let erased RepP1(_, _, _, rb, sb) = rq;
              let (c, erased rc) = inc(_, BP(b), RepP(_, _, rb));
              lift01(_, _, _, _, sub(_, _, subterm a, c, ra, rc), sa, sb)
            };
          }
        };
      }
    };
    P1(a) => {
      let erased RepP1(_, _, _, ra, sa) = px;
      match y : _ {
        BZ() => {
          let erased RepZ() = py;
          Above(BP(x), _, _, m, RepP(_, _, px), PlusZero(_))
        };
        BP(q) => {
          let erased RepP(_, _, rq) = py;
          match q : _ {
            One() => {
              let erased RepOne() = rq;
              lift11(_, _, _, _, sub(_, _, subterm a, BZ(), ra, RepZ()), sa, PlusZero(_))
            };
            P0(b) => {
              let erased RepP0(_, _, _, rb, sb) = rq;
              lift10(_, _, _, _, sub(_, _, subterm a, BP(b), ra, RepP(_, _, rb)), sa, sb)
            };
            P1(b) => {
              let erased RepP1(_, _, _, rb, sb) = rq;
              lift11(_, _, _, _, sub(_, _, subterm a, BP(b), ra, RepP(_, _, rb)), sa, sb)
            };
          }
        };
      }
    };
  }
}

fn subBin(erased m : Nat(), erased n : Nat(), x : Bin(), y : Bin(), erased px : Rep(x, m), erased py : Rep(y, n))
    -> (r : Diff(m, n)) {
  match x : _ {
    BZ() => {
      let erased RepZ() = px;
      match y : _ {
        BZ() => {
          let erased RepZ() = py;
          Above(BZ(), _, _, Zero(), RepZ(), PlusZero(_))
        };
        BP(q) => {
          let erased RepP(_, _, rq) = py;
          let erased NonZeroSucc(n1) = posPos(_, _, rq);
          Below(_, _, n1, PlusSucc(_, _, _, PlusZero(_)))
        };
      }
    };
    BP(p) => {
      let erased RepP(_, _, rp) = px;
      sub(_, _, p, y, rp, py)
    };
  }
}

fn halfBound(erased d : Nat(), erased k : Nat(), erased r2 : Nat(), erased w : Nat(), erased dd : Nat(),
    p : Plus(d, k, r2), l : Plus(Succ(r2), w, dd), sd : Plus(d, d, dd)) -> (erased q : Plus(Succ(k), w, d)) {
  let (erased bc, erased q1, erased q2) = plusAssoc(_, _, _, _, _, plusSucc(_, _, _, p), l);
  match erased plusCancel(_, _, _, _, q2, sd) : _ {
    Refl(_, _) => q1;
  }
}

fn divStep(erased m : Nat(), erased d : Nat(), erased dd : Nat(), erased nq : Nat(), erased nr : Nat(),
    erased t : Nat(), erased w : Nat(), q : Bin(), r : Bin(), y : Bin(), erased rq : Rep(q, nq),
    erased rr : Rep(r, nr), erased ry : Rep(y, d), erased tq : Times(nq, d, t), erased s : Plus(t, nr, m),
    erased l : Plus(Succ(nr), w, dd), erased sd : Plus(d, d, dd))
    -> (q1 : Bin(), r1 : Bin(), erased nq1 : Nat(), erased nr1 : Nat(), erased rq1 : Rep(q1, nq1),
        erased rr1 : Rep(r1, nr1), erased dm : DivMod(m, d, nq1, nr1)) {
  match subBin(_, _, r, y, rr, ry) : _ {
    Above(z, _, _, k, rz, p) => {
      let (q2, erased rq2) = inc(_, q, rq);
      let (erased u, erased s1, erased s2) = plusAssocRev(_, _, _, _, _, p, s);
      (q2, z, Succ(nq), k, rq2, rz,
        DivModIntro(_, _, _, _, u, _, TimesSucc(_, _, _, _, tq, s1), s2, halfBound(_, _, _, _, _, p, l, sd)))
    };
    Below(_, _, k, p) => (q, r, nq, nr, rq, rr, DivModIntro(_, _, _, _, t, k, tq, s, p));
  }
}

fn divPos(erased m : Nat(), erased d : Nat(), subterm x : Pos(), y : Bin(), erased px : PosRep(x, m),
    erased py : Rep(y, d), erased z : NonZero(d))
    -> (q : Bin(), r : Bin(), erased nq : Nat(), erased nr : Nat(), erased rq : Rep(q, nq),
        erased rr : Rep(r, nr), erased dm : DivMod(m, d, nq, nr)) {
  let (erased dd, erased sd) = plus(d, d);
  match x : _ {
    One() => {
      let erased RepOne() = px;
      let erased NonZeroSucc(_) = z;
      let (erased w, erased l) = ltDouble(_, _, _, _, _, PlusSucc(_, _, _, PlusZero(_)), PlusZero(_), sd);
      divStep(_, _, _, _, _, _, _, BZ(), BP(One()), y, RepZ(), RepP(_, _, RepOne()), py, TimesZero(_),
        PlusZero(_), l, sd)
    };
    P0(a) => {
      let erased RepP0(_, _, _, ra, sa) = px;
      let (q, r, erased nq, erased nr, erased rq, erased rr, erased dm) = divPos(_, _, subterm a, y, ra, py, z);
      let erased DivModIntro(_, _, _, _, t, _, tq, s, l) = dm;
      let (erased nq2, erased sq) = plus(nq, nq);
      let (erased nr2, erased sr) = plus(nr, nr);
      let (q2, erased rq2) = twice(_, _, q, rq, sq);
      let (r2, erased rr2) = twice(_, _, r, rr, sr);
      let (erased t2, erased st, erased tq2) = timesDouble(_, _, _, _, sq, tq);
      let (erased w, erased l2) = ltDouble(_, _, _, _, _, l, sr, sd);
      divStep(_, _, _, _, _, _, _, q2, r2, y, rq2, rr2, py, tq2, dsum(_, _, _, _, _, _, s, st, sr, sa),
        plusMove(_, _, _, l2), sd)
    };
    P1(a) => {
      let erased RepP1(_, _, _, ra, sa) = px;
      let (q, r, erased nq, erased nr, erased rq, erased rr, erased dm) = divPos(_, _, subterm a, y, ra, py, z);
      let erased DivModIntro(_, _, _, _, t, _, tq, s, l) = dm;
      let (erased nq2, erased sq) = plus(nq, nq);
      let (erased nr2, erased sr) = plus(nr, nr);
      let (q2, erased rq2) = twice(_, _, q, rq, sq);
      let (r2, erased rr2) = twice1(_, _, r, rr, sr);
      let (erased t2, erased st, erased tq2) = timesDouble(_, _, _, _, sq, tq);
      let (erased w, erased l2) = ltDouble(_, _, _, _, _, l, sr, sd);
      divStep(_, _, _, _, _, _, _, q2, r2, y, rq2, rr2, py, tq2,
        plusSucc(_, _, _, dsum(_, _, _, _, _, _, s, st, sr, sa)), l2, sd)
    };
  }
}

fn scan(subterm j : Nat(), x : Pos(), b : Bin(), erased n : Nat(), erased m : Nat(), erased c : Nat(),
    erased px : PosRep(x, n), erased rb : Rep(b, m), erased s : Shift(m, j, c), erased nd : NoDivBelow(n, c))
    -> (o : Option(Reach(n, Succ(m), j))) {
  match j : _ {
    Zero() => {
      let erased ShiftZ(_) = s;
      let (erased e, erased eq) = ndTwo(_, _, nd);
      match erased eq : _ {
        Refl(_, _) => {
          let (_, r, erased nq, erased nr, erased rq, erased rr, erased dm) =
            divPos(_, _, x, b, px, rb, NonZeroSucc(_));
          match r : _ {
            BZ() => None(_);
            BP(p) => {
              let erased RepP(_, _, rp) = rr;
              let erased NonZeroSucc(_) = posPos(_, _, rp);
              Some(_, ReachIntro(_, _, _, Succ(m), ShiftZ(_), NoDivStep(_, _, nd, NotDiv(_, _, _, _, dm))))
            };
          }
        };
      }
    };
    Succ(j1) => {
      let erased ShiftS(_, _, _, _, sm, s1) = s;
      let (b0, erased rb0) = twice(_, _, b, rb, sm);
      match scan(subterm j1, x, b0, _, _, _, px, rb0, s1, nd) : _ {
        None(_) => None(_);
        Some(_, v) => {
          let erased ReachIntro(_, _, _, _, s2, nd2) = v;
          let (b1, erased rb1) = twice1(_, _, b, rb, sm);
          match scan(subterm j1, x, b1, _, _, _, px, rb1, s2, nd2) : _ {
            None(_) => None(_);
            Some(_, v2) => {
              let erased ReachIntro(_, _, _, e2, s3, nd3) = v2;
              Some(_, ReachIntro(_, _, _, e2, ShiftS(_, _, _, _, succBoth(_, _, _, sm), s3), nd3))
            };
          }
        };
      }
    };
  }
}

fn cover(subterm h : Nat(), x : Pos(), erased n : Nat(), erased px : PosRep(x, n))
    -> (o : Option(Reach(n, Succ(Zero()), Succ(h)))) {
  match h : _ {
    Zero() => Some(_, ReachIntro(n, _, _, _, ShiftS(_, _, _, _, PlusSucc(_, _, _, PlusZero(_)), ShiftZ(_)),
      NoDivTwo(_)));
    Succ(h1) => match cover(subterm h1, x, _, px) : _ {
      None(_) => None(_);
      Some(_, v) => {
        let erased ReachIntro(_, _, _, _, s, nd) = v;
        match scan(h, x, BP(One()), _, _, _, px, RepP(_, _, RepOne()), s, nd) : _ {
          None(_) => None(_);
          Some(_, v2) => {
            let erased ReachIntro(_, _, _, e2, s2, nd2) = v2;
            Some(_, ReachIntro(_, _, _, e2, ShiftS(_, _, _, _, PlusSucc(_, _, _, PlusZero(_)), s2), nd2))
          };
        }
      };
    };
  }
}

fn pow2(subterm h : Nat())
    -> (b : Pos(), bb : Pos(), erased nb : Nat(), erased nbb : Nat(), erased rb : PosRep(b, nb),
        erased rbb : PosRep(bb, nbb), erased s : Shift(Succ(Zero()), h, nb), erased t : Times(nb, nb, nbb)) {
  match h : _ {
    Zero() => (One(), One(), Succ(Zero()), Succ(Zero()), RepOne(), RepOne(), ShiftZ(_),
      TimesSucc(_, _, _, _, TimesZero(_), PlusZero(_)));
    Succ(h1) => {
      let (b1, bb1, erased nb1, erased nbb1, erased rb1, erased rbb1, erased s1, erased t1) = pow2(subterm h1);
      let (erased nb2, erased sb) = plus(nb1, nb1);
      let (erased d1, erased p1, erased u1) = timesDouble(_, _, _, _, sb, t1);
      let (erased d2, erased p2, erased u2) = timesDouble(_, _, _, _, sb, timesComm(_, _, _, u1));
      (P0(b1), P0(P0(bb1)), nb2, d2, RepP0(_, _, _, rb1, sb), RepP0(_, _, _, RepP0(_, _, _, rbb1, p1), p2),
        ShiftS(_, _, _, _, PlusSucc(_, _, _, PlusZero(_)),
          shiftDouble(_, _, _, _, _, s1, PlusSucc(_, _, _, PlusZero(_)), sb)), u2)
    };
  }
}

fn halfLen(subterm x : Pos()) -> (h : Nat()) {
  match x : _ {
    One() => Zero();
    P0(a) => match a : _ {
      One() => Zero();
      P0(b) => Succ(halfLen(subterm b));
      P1(b) => Succ(halfLen(subterm b));
    };
    P1(a) => match a : _ {
      One() => Zero();
      P0(b) => Succ(halfLen(subterm b));
      P1(b) => Succ(halfLen(subterm b));
    };
  }
}

fn decidePrime(x : Bin(), erased n : Nat(), erased rx : Rep(x, n)) -> (o : Option(Prime(n))) {
  match x : _ {
    BZ() => None(_);
    BP(p) => {
      let erased RepP(_, _, rp) = rx;
      let h = halfLen(p);
      let (b, bb, erased nb, erased nbb, erased rb, erased rbb, erased sh, erased tb) = pow2(Succ(h));
      match sub(_, _, p, BP(b), rp, RepP(_, _, rb)) : _ {
        Below(_, _, _, _) => None(_);
        Above(_, _, _, k, _, le) => match sub(_, _, p, BP(bb), rp, RepP(_, _, rbb)) : _ {
          Above(_, _, _, _, _, _) => None(_);
          Below(_, _, w, lt) => match cover(h, p, _, rp) : _ {
            None(_) => None(_);
            Some(_, v) => {
              let erased ReachIntro(_, _, _, _, se, nd) = v;
              match erased shiftFunc(_, _, _, _, se, sh) : _ {
                Refl(_, _) => Some(_, PrimeIntro(_,
                  extend(k, _, _, _, _, _, _, nd, le, plusZeroRight(nb), nd, tb, lt)));
              }
            };
          };
        };
      }
    };
  }
}

let big = BP(P1(P1(P1(P1(P0(P1(P0(P0(P0(P1(P0(P0(P0(P0(P1(P0(P1(P1(P1(One()))))))))))))))))))));
let (erased nBig, erased rBig) = toNat(big);
comptime let Some(_, bigIsPrime) = decidePrime(big, nBig, rBig);

let composite = BP(P1(P1(P0(P1(P1(P1(P1(P0(P1(P1(P0(P0(P1(P0(P0(P0(P1(P1(P1(One()))))))))))))))))))));
let (erased nComposite, erased rComposite) = toNat(composite);
print decidePrime(composite, nComposite, rComposite);
